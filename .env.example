# Copie para .env.local e ajuste. Arquivos *.local NÃO vão para o Git.

# true  → telas usam dados fictícios em memória (src/mocks), sem backend
# false → chamadas reais à API (FastAPI)
VITE_API_MOCK=true

# Prefixo das rotas da API. Mantenha /api: em dev o Vite faz proxy, em produção o FastAPI serve o front.
VITE_API_BASE_URL=/api

# Para onde o proxy do Vite (somente em dev) encaminha /api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Tempo máximo de espera por resposta (ms). RNF03: bip → tela em até 2 s.
VITE_API_TIMEOUT_MS=8000
